-- =============================================
-- Room Type Pricing Analysis
-- Business Question: Which room type commands
-- highest price and best reviews?
-- =============================================

SELECT
    room_type,
    COUNT(*) AS total_listings,
    -- Using median instead of avg to avoid distortion from outlier listings
    ROUND(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY price::NUMERIC)::NUMERIC, 2) AS median_price,
    MIN(price::NUMERIC) AS min_price,
    MAX(price::NUMERIC) AS max_price,
    ROUND(AVG(review_scores_rating::NUMERIC), 2) AS avg_reviews
FROM listings
GROUP BY room_type
ORDER BY median_price DESC;
