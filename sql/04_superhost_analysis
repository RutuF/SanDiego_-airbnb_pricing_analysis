-- =============================================
-- Superhost vs Regular Host Analysis
-- Business Question: Do superhosts charge more
-- and get better reviews?
-- =============================================

WITH superhost_stats AS (
    SELECT
        host_is_superhost,
        COUNT(*) AS total_listings,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY price::NUMERIC) AS median_price,
        ROUND(AVG(review_scores_rating::NUMERIC), 2) AS avg_review_score,
        ROUND(AVG(number_of_reviews::NUMERIC), 2) AS avg_reviews,
        ROUND(AVG(availability_365::NUMERIC), 2) AS avg_availability
    FROM listings
    WHERE host_is_superhost IS NOT NULL
    GROUP BY host_is_superhost
)
SELECT
    CASE
        WHEN host_is_superhost = 't' THEN 'Superhost'
        ELSE 'Regular Host'
    END AS host_type,
    total_listings,
    ROUND(median_price::NUMERIC, 2) AS median_price,
    avg_review_score,
    avg_reviews,
    avg_availability
FROM superhost_stats;
