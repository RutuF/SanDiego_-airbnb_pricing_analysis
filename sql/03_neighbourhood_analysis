-- =============================================
-- Neighbourhood Pricing Analysis
-- Business Question: Which neighbourhoods offer the best value?
-- =============================================

WITH neighbourhood_median AS (
    SELECT 
        neighbourhood_cleansed,
        COUNT(*) AS total_listings,
        ROUND(CAST(PERCENTILE_CONT(0.5) WITHIN GROUP 
            (ORDER BY price::NUMERIC) AS NUMERIC), 2) AS median_price,
        MIN(price::NUMERIC) AS min_price,
        MAX(price::NUMERIC) AS max_price,
        ROUND(AVG(review_scores_rating::NUMERIC), 2) AS avg_review_score
    FROM listings
    GROUP BY neighbourhood_cleansed
    HAVING COUNT(*) >= 20
)
SELECT 
    neighbourhood_cleansed,
    total_listings,
    median_price,
    min_price,
    max_price,
    avg_review_score,
    RANK() OVER (ORDER BY median_price DESC) AS price_rank
FROM neighbourhood_median
ORDER BY median_price DESC;
